# Copy to .env and fill in the required secrets before starting the stack.
# Keep .env local. `make up` validates these values before Docker starts.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Secret token for /admin/* endpoints (X-API-Key header).
# Generate each secret independently with: openssl rand -hex 32
ADMIN_API_KEY=

# PostgreSQL superuser password
POSTGRES_PASSWORD=

# Least-privilege application database user password.
# Use a URL-safe value because it is embedded in DATABASE_URL.
SHORTLY_DB_PASSWORD=

# Redis AUTH password. Use a URL-safe value because it is embedded in REDIS_URL.
REDIS_PASSWORD=

# Canonical public origin used when returning newly-created short links.
PUBLIC_BASE_URL=https://localhost:9443

# Optional: required only when starting monitoring/docker-compose.monitoring.yml.
# Generate independently, e.g. `openssl rand -hex 32`.
GRAFANA_ADMIN_PASSWORD=

# ── OPTIONAL (tuning) ─────────────────────────────────────────────────────────

# Dashboard/reference cache capacity used for fill-ratio reporting. Redis
# eviction is governed by its maxmemory configuration, not by an entry count.
CACHE_SIZE=2000

# Cache TTL in seconds
CACHE_TTL=300

# Virtual nodes per physical ring node (higher = more even distribution)
VNODES_PER_NODE=150

# ── LOCAL GATEWAY / TLS ──────────────────────────────────────────────────────

# Loopback is the safe default for Cloudflare Tunnel and local development.
# Set 0.0.0.0 only when you intentionally expose nginx directly and have an
# appropriate firewall/reverse-proxy policy.
NGINX_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8888
HTTPS_PORT=9443

# Subject/SAN used by scripts/gen_certs.sh for the local self-signed cert.
TLS_DOMAIN=localhost
