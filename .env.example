# .env.example
# Copy to .env and fill in real values before running docker compose.
# docker compose automatically reads .env from the project root.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Secret token for /admin/* endpoints (X-API-Key header).
# Generate one: openssl rand -hex 32
ADMIN_API_KEY=changeme-replace-with-a-real-secret

# PostgreSQL superuser password
POSTGRES_PASSWORD=postgres_secret

# PgBouncer / app user password  (must match scripts/init_postgres.sql)
SHORTLY_DB_PASSWORD=shortly_secret

# ── OPTIONAL (tuning) ─────────────────────────────────────────────────────────

# Redis cache size (entries). 2000 = ~2 MB of URL strings.
CACHE_SIZE=2000

# Cache TTL in seconds
CACHE_TTL=300

# Virtual nodes per physical ring node (higher = more even distribution)
VNODES_PER_NODE=150

# Gunicorn worker timeout
NODE_TIMEOUT_SEC=5
